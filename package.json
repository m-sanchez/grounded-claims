{
  "name": "grounded-claims",
  "version": "1.1.0",
  "description": "The verification kit: a check chain where the LLM judge is structurally advisory, a composer firewalled from the network by test, replay from self-contained records.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-sanchez/grounded-claims.git"
  },
  "author": "Miguel Sanchez <contact@miguelsanchez.co.uk>",
  "license": "MIT",
  "keywords": [
    "llm",
    "hallucination",
    "verification",
    "guardrails",
    "grounding",
    "rag",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.7.0"
  },
  "types": "./dist/index.d.ts"
}
